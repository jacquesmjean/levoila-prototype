{
  "//": "Tenant deployment. The service desk is the whole site here — Levoila's public marketing pages (index.html, dispatches) are not shipped. See .vercelignore.",
  "rewrites": [
    { "source": "/", "destination": "/servicedesk.html" },
    { "source": "/servicedesk", "destination": "/servicedesk.html" },
    { "source": "/vendor-onboarding", "destination": "/vendor-onboarding.html" },
    { "source": "/join-onboarding", "destination": "/join-onboarding.html" },
    { "source": "/sign", "destination": "/sign.html" },
    { "source": "/transparency", "destination": "/transparency.html" },
    { "source": "/portal", "destination": "/portal.html" }
  ],
  "headers": [
    { "source": "/(.*)", "headers": [
      { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
    ]},
    { "source": "/servicedesk", "headers": [
      { "key": "X-Frame-Options", "value": "DENY" }
    ]},
    { "source": "/", "headers": [
      { "key": "X-Frame-Options", "value": "DENY" }
    ]}
  ]
}
